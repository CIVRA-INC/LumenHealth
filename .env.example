# Copy to .env (`pnpm bootstrap` does this for you). Never commit .env.
# Values below are for LOCAL DEVELOPMENT ONLY.

NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Runtime connection: the restricted role, subject to row-level security.
DATABASE_URL=postgresql://lumen_app:lumen_app_dev_password@localhost:5432/lumenhealth
# Schema owner: used by migrations and seed only (bypasses row-level security).
MIGRATION_DATABASE_URL=postgresql://lumen:lumen_dev_password@localhost:5432/lumenhealth
# Integration tests run against their own database (created by docker init script).
TEST_DATABASE_URL=postgresql://lumen_app:lumen_app_dev_password@localhost:5432/lumenhealth_test
TEST_MIGRATION_DATABASE_URL=postgresql://lumen:lumen_dev_password@localhost:5432/lumenhealth_test

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# Origins allowed to send state-changing requests (comma separated). The web app
# is served same-origin in production; in development Vite proxies /api.
WEB_ORIGINS=http://localhost:5173

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=lh_session
# Set to true whenever the app is served over HTTPS (always, in production).
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ── Invitations and email ────────────────────────────────────────────────────
# Public origin of the web app: invitation links are built from it. Production: https://your-frontend-domain
APP_BASE_URL=http://localhost:5173
INVITATION_TTL_HOURS=168
# smtp (production) | log (development: prints the invitation link in the API log) | disabled
EMAIL_DRIVER=log
EMAIL_FROM=LumenHealth <no-reply@localhost>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── Web (Vite dev server) ────────────────────────────────────────────────────
WEB_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# ── End-to-end tests (Playwright) ────────────────────────────────────────────
# A disposable database, dropped and re-seeded on every run. Never point this at real data.
E2E_MIGRATION_DATABASE_URL=postgresql://lumen:lumen_dev_password@localhost:5432/lumenhealth_e2e
E2E_DATABASE_URL=postgresql://lumen_app:lumen_app_dev_password@localhost:5432/lumenhealth_e2e

# ── Visual review (`pnpm shots`) ─────────────────────────────────────────────
# Optional. Another disposable database (must end in "_visual"), recreated from the standard seed on every
# run. When these are unset the URLs are the e2e ones with "_e2e" replaced by "_visual".
# VISUAL_MIGRATION_DATABASE_URL=postgresql://lumen:lumen_dev_password@localhost:5432/lumenhealth_visual
# VISUAL_DATABASE_URL=postgresql://lumen_app:lumen_app_dev_password@localhost:5432/lumenhealth_visual
