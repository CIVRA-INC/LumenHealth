# LumenHealth environment template. Copy to `.env` at the repo root.
#
# Legend:  [Required] must be set, startup fails without it.
#          [Optional] has a default, shown in the comment.
# Every value written REPLACE_ME is a placeholder: startup validation rejects it,
# so a deployment cannot run with it by accident. Generate real secrets with e.g.
#   openssl rand -base64 48
#
# Web: Next.js reads `.env*` from apps/web, not the repo root. `apps/web/next.config.ts`
# loads this root `.env` for you (existing variables are not overridden); you can also put
# `NEXT_PUBLIC_*` values in `apps/web/.env.local`. NEXT_PUBLIC_* values are baked into the
# build, so changing one needs a rebuild.

# ── API (apps/api) ────────────────────────────────────────────────────────────
# [Optional] default 4000
API_PORT=4000

# [Required] JWT secret read by @lumen/config — min 32 chars
JWT_SECRET=REPLACE_ME

# [Required] access-token signing key used by the API token service — min 32 chars,
# not a known default. See docs/auth-secret-rotation.md.
AUTH_ACCESS_TOKEN_KEY=REPLACE_ME
# [Optional] previous key, accepted for verification while rotating
# AUTH_ACCESS_TOKEN_KEY_PREVIOUS=

# [Optional] token TTLs in seconds — defaults 900 / 604800
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=604800

# [Optional] bcrypt cost factor — default 12
# BCRYPT_ROUNDS=12

# [Optional] MongoDB; the API falls back to in-memory repositories when unset
# MONGODB_URI=
# MONGODB_DB=lumenhealth

# [Required only with field encryption] PII encryption key ring
# PII_KEYS=keyId:REPLACE_ME
# PII_ACTIVE_KEY_ID=keyId
# PII_BLIND_INDEX_KEY=REPLACE_ME

# [Optional] audit archive and background jobs
# AUDIT_ARCHIVE_DIR=
# AUDIT_RETENTION_INTERVAL_MS=
# AUDIT_INTEGRITY_SAMPLE_SIZE=
# AUDIT_INTEGRITY_INTERVAL_MS=

# ── Web (apps/web) ────────────────────────────────────────────────────────────
# [Required in production] browser-visible API base URL (http or https, no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Stellar service (apps/stellar-service) ────────────────────────────────────
# [Optional] testnet | mainnet — default testnet
STELLAR_NETWORK=testnet
# [Optional] default: the testnet Horizon URL
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# [Optional] signed service-to-service requests: comma-separated keyId:secret pairs, the
# first signs and all verify (dev fallback exists; set it everywhere else)
# INTERNAL_SERVICE_SECRETS=key1:REPLACE_ME
# [Optional, deprecated] no longer used for authentication
# INTERNAL_SERVICE_TOKEN=

# [Optional] where the API reaches the service, and the port the service listens on
STELLAR_SERVICE_URL=http://localhost:4100
STELLAR_SERVICE_PORT=4100

# [Optional] anchoring scheduler (ms) — defaults 60000 / 900000
# ANCHOR_INTERVAL_MS=60000
# ANCHOR_RECONCILE_STALE_THRESHOLD_MS=900000

# [Required] public key of the shared multisig anchor account (the account anchor
# transactions are submitted from, not any individual cosigner's account)
STELLAR_ANCHOR_ACCOUNT_PUBLIC_KEY=

# [Required] comma-separated secret seeds of every anchor cosigner this deployment holds —
# never expose to clients or commit real values
STELLAR_ANCHOR_COSIGNER_SECRETS=

# [Optional] combined cosigner weight required to submit — default: every cosigner
# STELLAR_ANCHOR_REQUIRED_WEIGHT=

# [Required] signing key for compliance-export manifests; must differ from every anchor
# cosigner key — never commit a real value
STELLAR_EXPORT_SIGNING_SECRET=

# [Optional] export-signing key rotation log, a SigningKeyRecord[] JSON array
# (see docs/stellar-key-rotation.md)
# STELLAR_SIGNING_KEY_REGISTRY_JSON=
