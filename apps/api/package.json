{
  "name": "@lumen/api",
  "private": true,
  "version": "0.1.0",
  "description": "LumenHealth API \u2014 NestJS modular monolith",
  "scripts": {
    "prebuild": "pnpm db:generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm db:generate && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm db:generate && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts",
    "db:reset": "node --env-file-if-exists=../../.env --import tsx prisma/reset-dev.ts",
    "openapi:export": "node --env-file-if-exists=../../.env dist/scripts/export-openapi.js",
    "e2e:prepare": "pnpm db:generate && node --env-file-if-exists=../../.env --import tsx prisma/e2e-prepare.ts"
    "visual:prepare": "node --env-file-if-exists=../../.env --import tsx prisma/visual-prepare.ts"
  },
  "dependencies": {
    "@lumen/contracts": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lumen/config": "workspace:*",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "1.16.17",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
