# ── API (apps/api) ────────────────────────────────────────────────────────────
API_PORT=4000

# JWT signing secret — min 32 chars, never commit a real value
JWT_SECRET=change-me-before-production-use

# Token TTLs in seconds (optional — defaults shown)
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=604800

# bcrypt cost factor (optional — default: 12)
# BCRYPT_ROUNDS=12

# ── Web (apps/web) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Stellar service (apps/stellar-service) ────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Shared secret authenticating service-to-service calls between apps/api and apps/stellar-service
INTERNAL_SERVICE_TOKEN=change-me-before-production-use
STELLAR_SERVICE_URL=http://localhost:4100
STELLAR_SERVICE_PORT=4100

# How often the anchoring scheduler runs a batch, and how long the queue can
# go unanchored before reconciliation forces an extra attempt (ms, optional)
# ANCHOR_INTERVAL_MS=60000
# ANCHOR_RECONCILE_STALE_THRESHOLD_MS=900000

# The shared multisig anchor account's public key (the account anchor
# transactions are submitted *from*, not any individual cosigner's own account)
STELLAR_ANCHOR_ACCOUNT_PUBLIC_KEY=

# Comma-separated Stellar secret seeds for every anchor cosigner this
# deployment holds locally — never expose to clients or commit real values
STELLAR_ANCHOR_COSIGNER_SECRETS=

# Combined cosigner weight required to submit an anchor transaction (must
# match the threshold configured on-chain for the account above). Optional —
# defaults to requiring every cosigner in STELLAR_ANCHOR_COSIGNER_SECRETS.
# STELLAR_ANCHOR_REQUIRED_WEIGHT=

# Signing key for compliance-export manifests — deliberately a different
# key from every anchor cosigner above; never commit a real value
STELLAR_EXPORT_SIGNING_SECRET=

# Documented export-signing key rotation log, as a SigningKeyRecord[] JSON
# array (see docs/stellar-key-rotation.md). Optional — omitting it treats
# the current STELLAR_EXPORT_SIGNING_SECRET key as always having been
# authorized, which is fine until the first rotation.
# STELLAR_SIGNING_KEY_REGISTRY_JSON=
