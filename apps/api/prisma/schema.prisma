// LumenHealth data model.
//
// Conventions
//  - Primary keys are UUIDv7 generated by the application: globally unique, time-ordered, and
//    safe to mint on a facility-local node later (docs/architecture/offline-sync.md).
//  - Every tenant-owned row carries organizationId. Child rows reference their parent through a
//    composite foreign key that includes organizationId (and patientId for clinical rows), so the
//    database itself rejects cross-tenant and cross-patient links.
//  - Timestamps are stored in UTC (timestamptz). Calendar-only values (date of birth) use DATE.
//  - Tenant tables also have row-level security policies defined in raw SQL migrations.
//    Raw-SQL-only objects (RLS, partial/exclusion constraints, triggers) are listed in
//    docs/development/database.md so they are reviewed whenever `prisma migrate dev` runs.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  ORG_ADMIN
  CLINICIAN
  NURSE
  FRONT_DESK
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNKNOWN
}

enum IdentifierType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
}

enum AppointmentType {
  SCHEDULED
  WALK_IN
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentOutcome {
  SEEN
  NO_SHOW
  CANCELLED_BY_PATIENT
  CANCELLED_BY_CLINIC
  LEFT_WITHOUT_BEING_SEEN
}

enum Priority {
  ROUTINE
  URGENT
}

enum EncounterStatus {
  IN_PROGRESS
  FINALIZED
  CLOSED
  ENTERED_IN_ERROR
}

enum Disposition {
  DISCHARGED_HOME
  REFERRED
  ADMITTED
  LEFT_AGAINST_ADVICE
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
}

enum DiagnosisCertainty {
  PROVISIONAL
  CONFIRMED
}

enum MedicationRoute {
  ORAL
  TOPICAL
  INTRAVENOUS
  INTRAMUSCULAR
  SUBCUTANEOUS
  INHALED
  OTHER
}

enum MedicationOrderStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

// ── Organisations and access ──────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  /// IANA time zone used to decide what "today" means for this organisation.
  timezone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  branches     Branch[]
  departments  Department[]
  memberships  Membership[]
  patients     Patient[]
  appointments Appointment[]
  encounters   Encounter[]
  counters     Counter[]
  auditEvents  AuditEvent[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id])

  departments      Department[]
  membershipAccess MembershipBranch[]
  sessions         Session[]
  appointments     Appointment[]
  encounters       Encounter[]
  patients         Patient[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@map("branches")
}

model Department {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String       @db.Uuid
  name           String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId])

  appointments Appointment[]

  @@unique([branchId, name])
  @@unique([id, organizationId])
  @@map("departments")
}

/// A person who can sign in. Global: one user may belong to several organisations.
model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-case.
  email               String     @unique
  passwordHash        String
  fullName            String
  status              UserStatus @default(ACTIVE)
  mustChangePassword  Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(3)
  lastLoginAt         DateTime?  @db.Timestamptz(3)
  passwordChangedAt   DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

/// A user's role within one organisation.
model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           Role
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])

  branches MembershipBranch[]
  sessions Session[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Branches a membership may work in.
model MembershipBranch {
  membershipId   String     @db.Uuid
  branchId       String     @db.Uuid
  organizationId String     @db.Uuid
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch         Branch     @relation(fields: [branchId, organizationId], references: [id, organizationId])

  @@id([membershipId, branchId])
  @@map("membership_branches")
}

/// Server-side session. The browser only ever holds an opaque random token; we store its hash.
model Session {
  id           String     @id @default(uuid(7)) @db.Uuid
  tokenHash    String     @unique
  userId       String     @db.Uuid
  membershipId String     @db.Uuid
  branchId     String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime   @default(now()) @db.Timestamptz(3)
  /// Absolute expiry. The idle timeout is enforced separately from lastSeenAt.
  expiresAt    DateTime   @db.Timestamptz(3)
  revokedAt    DateTime?  @db.Timestamptz(3)
  ipAddress    String?
  userAgent    String?
  user         User       @relation(fields: [userId], references: [id])
  membership   Membership @relation(fields: [membershipId], references: [id])
  branch       Branch     @relation(fields: [branchId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ── Patient registry ──────────────────────────────────────────────────────────

model Patient {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @db.Uuid
  /// Patient-facing identifier, unique within the organisation (e.g. LH-000123).
  mrn                String
  givenName          String
  middleName         String?
  familyName         String
  dateOfBirth        DateTime @db.Date
  sex                Sex
  /// E.164.
  phone              String
  email              String?
  addressLine1       String?
  city               String?
  state              String?
  country            String   @default("NG")
  /// Normalised "family|given" key used for duplicate detection.
  nameKey            String
  registeredBranchId String   @db.Uuid
  /// Optimistic-concurrency token, incremented on every update.
  version            Int      @default(1)
  createdById        String   @db.Uuid
  updatedById        String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  organization      Organization        @relation(fields: [organizationId], references: [id])
  registeredBranch  Branch              @relation(fields: [registeredBranchId, organizationId], references: [id, organizationId])
  identifiers       PatientIdentifier[]
  emergencyContacts EmergencyContact[]
  appointments      Appointment[]
  encounters        Encounter[]

  @@unique([organizationId, mrn])
  @@unique([id, organizationId])
  @@index([organizationId, nameKey, dateOfBirth])
  @@index([organizationId, phone])
  @@index([organizationId, familyName, givenName])
  @@index([organizationId, createdAt])
  @@index([organizationId, dateOfBirth])
  @@map("patients")
}

model PatientIdentifier {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  patientId      String         @db.Uuid
  type           IdentifierType
  /// Upper-cased with whitespace removed.
  value          String
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  patient        Patient        @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, type, value])
  @@index([patientId])
  @@map("patient_identifiers")
}

model EmergencyContact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  patientId      String   @db.Uuid
  name           String
  relationship   String
  phone          String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  patient        Patient  @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([patientId])
  @@map("emergency_contacts")
}

/// Gap-free-per-scope counters (MRN sequence, daily queue tickets), incremented atomically.
model Counter {
  organizationId String       @db.Uuid
  scope          String
  value          Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, scope])
  @@map("counters")
}

// ── Scheduling and queue ──────────────────────────────────────────────────────
// The queue is not a separate table: it is the set of CHECKED_IN appointments ordered by
// priority and check-in time.

model Appointment {
  id                    String              @id @default(uuid(7)) @db.Uuid
  organizationId        String              @db.Uuid
  branchId              String              @db.Uuid
  patientId             String              @db.Uuid
  departmentId          String?             @db.Uuid
  clinicianId           String?             @db.Uuid
  type                  AppointmentType
  status                AppointmentStatus   @default(SCHEDULED)
  priority              Priority            @default(ROUTINE)
  outcome               AppointmentOutcome?
  outcomeNote           String?
  scheduledStart        DateTime            @db.Timestamptz(3)
  scheduledEnd          DateTime            @db.Timestamptz(3)
  reason                String?
  /// Per-branch, per-local-day queue number assigned at check-in.
  ticketNumber          Int?
  checkedInAt           DateTime?           @db.Timestamptz(3)
  consultationStartedAt DateTime?           @db.Timestamptz(3)
  completedAt           DateTime?           @db.Timestamptz(3)
  cancelledAt           DateTime?           @db.Timestamptz(3)
  version               Int                 @default(1)
  createdById           String              @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId])
  patient      Patient      @relation(fields: [patientId, organizationId], references: [id, organizationId])
  department   Department?  @relation(fields: [departmentId, organizationId], references: [id, organizationId])
  encounter    Encounter?

  @@unique([id, organizationId])
  @@unique([id, organizationId, patientId])
  @@index([organizationId, branchId, scheduledStart])
  @@index([organizationId, branchId, status, checkedInAt])
  @@index([organizationId, patientId, scheduledStart])
  @@map("appointments")
}

// ── Clinical encounters ───────────────────────────────────────────────────────

model Encounter {
  id                    String          @id @default(uuid(7)) @db.Uuid
  organizationId        String          @db.Uuid
  branchId              String          @db.Uuid
  patientId             String          @db.Uuid
  appointmentId         String?         @unique @db.Uuid
  attendingId           String          @db.Uuid
  status                EncounterStatus @default(IN_PROGRESS)
  startedAt             DateTime        @default(now()) @db.Timestamptz(3)
  finalizedAt           DateTime?       @db.Timestamptz(3)
  finalizedById         String?         @db.Uuid
  closedAt              DateTime?       @db.Timestamptz(3)
  closedById            String?         @db.Uuid
  disposition           Disposition?
  dischargeInstructions String?
  voidedAt              DateTime?       @db.Timestamptz(3)
  voidedById            String?         @db.Uuid
  voidReason            String?
  version               Int             @default(1)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId])
  patient      Patient      @relation(fields: [patientId, organizationId], references: [id, organizationId])
  appointment  Appointment? @relation(fields: [appointmentId, organizationId, patientId], references: [id, organizationId, patientId])

  note             ClinicalNote?
  vitals           VitalSigns[]
  diagnoses        Diagnosis[]
  medicationOrders MedicationOrder[]
  addenda          Addendum[]

  /// Target of the composite foreign keys on every clinical child row.
  @@unique([id, organizationId, patientId])
  @@unique([appointmentId, organizationId, patientId])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, startedAt])
  @@index([organizationId, patientId, startedAt])
  @@map("encounters")
}

model ClinicalNote {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  encounterId    String    @unique @db.Uuid
  patientId      String    @db.Uuid
  chiefComplaint String?
  history        String?
  examination    String?
  assessment     String?
  plan           String?
  updatedById    String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  encounter      Encounter @relation(fields: [encounterId, organizationId, patientId], references: [id, organizationId, patientId])

  @@unique([encounterId, organizationId, patientId])
  @@map("clinical_notes")
}

model VitalSigns {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @db.Uuid
  encounterId     String    @db.Uuid
  patientId       String    @db.Uuid
  recordedAt      DateTime  @default(now()) @db.Timestamptz(3)
  recordedById    String    @db.Uuid
  temperatureC    Decimal?  @db.Decimal(4, 1)
  heartRate       Int?
  respiratoryRate Int?
  systolicBp      Int?
  diastolicBp     Int?
  spo2            Int?
  weightKg        Decimal?  @db.Decimal(5, 1)
  heightCm        Decimal?  @db.Decimal(4, 1)
  note            String?
  enteredInError  Boolean   @default(false)
  errorReason     String?
  errorMarkedById String?   @db.Uuid
  encounter       Encounter @relation(fields: [encounterId, organizationId, patientId], references: [id, organizationId, patientId])

  @@index([encounterId, recordedAt])
  @@map("vital_signs")
}

model Diagnosis {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @db.Uuid
  encounterId    String             @db.Uuid
  patientId      String             @db.Uuid
  description    String
  icd10Code      String?
  type           DiagnosisType      @default(SECONDARY)
  certainty      DiagnosisCertainty @default(PROVISIONAL)
  recordedById   String             @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  encounter      Encounter          @relation(fields: [encounterId, organizationId, patientId], references: [id, organizationId, patientId])

  @@index([encounterId])
  @@index([organizationId, patientId])
  @@map("diagnoses")
}

model MedicationOrder {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @db.Uuid
  encounterId    String                @db.Uuid
  patientId      String                @db.Uuid
  drugName       String
  strength       String?
  form           String?
  route          MedicationRoute       @default(ORAL)
  dose           String
  frequency      String
  durationDays   Int?
  quantity       Int?
  instructions   String?
  status         MedicationOrderStatus @default(DRAFT)
  cancelReason   String?
  prescribedById String                @db.Uuid
  activatedAt    DateTime?             @db.Timestamptz(3)
  cancelledAt    DateTime?             @db.Timestamptz(3)
  cancelledById  String?               @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  encounter      Encounter             @relation(fields: [encounterId, organizationId, patientId], references: [id, organizationId, patientId])

  @@index([encounterId])
  @@index([organizationId, patientId])
  @@map("medication_orders")
}

/// Corrections to signed documentation: append-only.
model Addendum {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  encounterId    String    @db.Uuid
  patientId      String    @db.Uuid
  authorId       String    @db.Uuid
  text           String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  encounter      Encounter @relation(fields: [encounterId, organizationId, patientId], references: [id, organizationId, patientId])

  @@index([encounterId, createdAt])
  @@map("addenda")
}

// ── Audit ─────────────────────────────────────────────────────────────────────

/// Append-only. UPDATE/DELETE are revoked from the application role and blocked by a trigger.
/// Metadata must never contain clinical content, credentials, or free-text patient data.
model AuditEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Null only for events that occur before an organisation context exists (e.g. failed sign-in).
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  patientId      String?       @db.Uuid
  outcome        AuditOutcome  @default(SUCCESS)
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  occurredAt     DateTime      @default(now()) @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, patientId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}
