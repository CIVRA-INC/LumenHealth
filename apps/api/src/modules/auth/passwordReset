import {
  BadRequestException,
  Injectable,
  NotFoundException,
} from '@nestjs/common';

import * as bcrypt from 'bcrypt';
import * as crypto from 'crypto';

// ============================================================
// USER MODEL
// ============================================================

export interface User {
  id: string;
  email: string;

  // Current password hash.
  passwordHash: string;

  // Password reset fields.
  passwordResetTokenHash?: string;
  passwordResetExpiresAt?: Date;

  // Useful for invalidating sessions/tokens.
  passwordChangedAt?: Date;

  createdAt: Date;
  updatedAt: Date;
}

// ============================================================
// DTO
// ============================================================

export class ConfirmPasswordResetDto {
  token!: string;
  newPassword!: string;
  confirmPassword!: string;
}

// ============================================================
// RESPONSE
// ============================================================

export interface PasswordResetResponse {
  message: string;
}

// ============================================================
// USER REPOSITORY
// ============================================================

export interface UserRepository {
  findById(
    id: string,
  ): Promise<User | null>;

  findByPasswordResetTokenHash(
    tokenHash: string,
  ): Promise<User | null>;

  update(
    id: string,
    changes: Partial<User>,
  ): Promise<User>;
}

// ============================================================
// PASSWORD RESET SERVICE
// ============================================================

@Injectable()
export class PasswordResetService {

  private readonly BCRYPT_ROUNDS = 12;

  // ----------------------------------------------------------
  // CONFIRM PASSWORD RESET
  // ----------------------------------------------------------

  async confirmPasswordReset(
    dto: ConfirmPasswordResetDto,
  ): Promise<PasswordResetResponse> {

    // ========================================================
    // 1. VALIDATE TOKEN
    // ========================================================

    if (
      !dto.token ||
      dto.token.trim().length === 0
    ) {
      throw new BadRequestException(
        'Password reset token is required',
      );
    }

    // ========================================================
    // 2. VALIDATE NEW PASSWORD
    // ========================================================

    this.validatePassword(
      dto.newPassword,
    );

    // ========================================================
    // 3. CONFIRM PASSWORD
    // ========================================================

    if (
      dto.newPassword !==
      dto.confirmPassword
    ) {
      throw new BadRequestException(
        'Passwords do not match',
      );
    }

    // ========================================================
    // 4. HASH RESET TOKEN
    // ========================================================

    /*
     * The raw token is never stored in the database.
     *
     * The token supplied by the client is hashed and the hash
     * is used to locate the user.
     */

    const tokenHash =
      this.hashResetToken(
        dto.token,
      );

    // ========================================================
    // 5. FIND USER
    // ========================================================

    const user =
      await this.repository
        .findByPasswordResetTokenHash(
          tokenHash,
        );

    if (!user) {
      throw new BadRequestException(
        'Invalid or expired password reset token',
      );
    }

    // ========================================================
    // 6. VERIFY TOKEN EXPIRATION
    // ========================================================

    if (
      !user.passwordResetExpiresAt
    ) {
      throw new BadRequestException(
        'Invalid or expired password reset token',
      );
    }

    if (
      user.passwordResetExpiresAt
        .getTime() <= Date.now()
    ) {

      /*
       * Remove the expired reset credentials.
       */

      await this.repository.update(
        user.id,
        {
          passwordResetTokenHash:
            undefined,

          passwordResetExpiresAt:
            undefined,
        },
      );

      throw new BadRequestException(
        'Invalid or expired password reset token',
      );
    }

    // ========================================================
    // 7. PREVENT REUSING CURRENT PASSWORD
    // ========================================================

    const samePassword =
      await bcrypt.compare(
        dto.newPassword,
        user.passwordHash,
      );

    if (samePassword) {
      throw new BadRequestException(
        'New password must be different from the current password',
      );
    }

    // ========================================================
    // 8. HASH NEW PASSWORD
    // ========================================================

    /*
     * THIS IS THE IMPORTANT PART.
     *
     * The plaintext password must never be stored.
     *
     * We create a new bcrypt hash and then persist THIS HASH
     * to the user's passwordHash field below.
     */

    const newPasswordHash =
      await bcrypt.hash(
        dto.newPassword,
        this.BCRYPT_ROUNDS,
      );

    // ========================================================
    // 9. PERSIST NEW PASSWORD HASH
    // ========================================================

    /*
     * BUG THAT THIS ISSUE FIXES:
     *
     * A broken implementation may do:
     *
     *   const hash = await bcrypt.hash(password, 12);
     *
     *   // ...but never save `hash`.
     *
     * Or it may accidentally save the plaintext password.
     *
     * The correct implementation MUST update:
     *
     *   passwordHash
     *
     * with the newly generated hash.
     */

    await this.repository.update(
      user.id,
      {
        passwordHash:
          newPasswordHash,

        passwordChangedAt:
          new Date(),

        /*
         * ====================================================
         * 10. INVALIDATE RESET TOKEN
         * ====================================================
         *
         * Reset tokens are single-use.
         */

        passwordResetTokenHash:
          undefined,

        passwordResetExpiresAt:
          undefined,
      },
    );

    // ========================================================
    // 11. SUCCESS
    // ========================================================

    return {
      message:
        'Password has been reset successfully.',
    };
  }

  // ==========================================================
  // HASH RESET TOKEN
  // ==========================================================

  private hashResetToken(
    token: string,
  ): string {

    return crypto
      .createHash('sha256')
      .update(token)
      .digest('hex');
  }

  // ==========================================================
  // PASSWORD VALIDATION
  // ==========================================================

  private validatePassword(
    password: string,
  ): void {

    if (
      !password ||
      password.length < 12
    ) {
      throw new BadRequestException(
        'Password must contain at least 12 characters',
      );
    }

    if (
      password.length > 128
    ) {
      throw new BadRequestException(
        'Password must not exceed 128 characters',
      );
    }

    if (
      !/[A-Z]/.test(password)
    ) {
      throw new BadRequestException(
        'Password must contain an uppercase letter',
      );
    }

    if (
      !/[a-z]/.test(password)
    ) {
      throw new BadRequestException(
        'Password must contain a lowercase letter',
      );
    }

    if (
      !/[0-9]/.test(password)
    ) {
      throw new BadRequestException(
        'Password must contain a number',
      );
    }

    if (
      !/[^A-Za-z0-9]/.test(password)
    ) {
      throw new BadRequestException(
        'Password must contain a special character',
      );
    }
  }

  // ==========================================================
  // CONSTRUCTOR
  // ==========================================================

  constructor(
    private readonly repository:
      UserRepository,
  ) {}
}

// ============================================================
// CONTROLLER
// ============================================================

import {
  Body,
  Controller,
  Post,
} from '@nestjs/common';

@Controller('auth')
export class PasswordResetController {

  constructor(
    private readonly passwordResetService:
      PasswordResetService,
  ) {}

  // ==========================================================
  // CONFIRM RESET
  // ==========================================================

  @Post('reset-password/confirm')
  async confirmReset(
    @Body()
    dto: ConfirmPasswordResetDto,
  ): Promise<PasswordResetResponse> {

    return this.passwordResetService
      .confirmPasswordReset(
        dto,
      );
  }
}

// ============================================================
// PRISMA IMPLEMENTATION EXAMPLE
// ============================================================

/*
 * If the project uses Prisma, the repository implementation
 * should ultimately perform an update similar to:
 *
 *
 * async update(
 *   id: string,
 *   changes: Partial<User>,
 * ): Promise<User> {
 *
 *   return this.prisma.user.update({
 *     where: {
 *       id,
 *     },
 *
 *     data: {
 *       passwordHash:
 *         changes.passwordHash,
 *
 *       passwordChangedAt:
 *         changes.passwordChangedAt,
 *
 *       passwordResetTokenHash:
 *         changes.passwordResetTokenHash,
 *
 *       passwordResetExpiresAt:
 *         changes.passwordResetExpiresAt,
 *     },
 *   });
 * }
 *
 *
 * The critical database operation is:
 *
 * UPDATE users
 * SET
 *   password_hash = :newPasswordHash,
 *   password_changed_at = NOW(),
 *   password_reset_token_hash = NULL,
 *   password_reset_expires_at = NULL
 * WHERE id = :userId;
 */

// ============================================================
// TYPEORM IMPLEMENTATION EXAMPLE
// ============================================================

/*
 * If TypeORM is used, the important section becomes:
 *
 *
 * await this.userRepository.update(
 *   user.id,
 *   {
 *     passwordHash:
 *       newPasswordHash,
 *
 *     passwordChangedAt:
 *       new Date(),
 *
 *     passwordResetTokenHash:
 *       null,
 *
 *     passwordResetExpiresAt:
 *       null,
 *   },
 * );
 *
 *
 * The important thing is that the generated hash is actually
 * included in the persistence operation.
 */

// ============================================================
// BROKEN IMPLEMENTATION EXAMPLE
// ============================================================

/*
 * The bug usually looks similar to this:
 *
 *
 * async confirmReset(token, newPassword) {
 *
 *   const user =
 *     await findUserByToken(token);
 *
 *   const hash =
 *     await bcrypt.hash(
 *       newPassword,
 *       12,
 *     );
 *
 *   // BUG:
 *   // hash is calculated but never persisted.
 *
 *   return {
 *     message:
 *       'Password reset successfully',
 *   };
 * }
 *
 *
 * The API reports success, but the database still contains
 * the old password hash.
 */

// ============================================================
// CORRECT IMPLEMENTATION
// ============================================================

/*
 *
 * const newPasswordHash =
 *   await bcrypt.hash(
 *     newPassword,
 *     12,
 *   );
 *
 * await repository.update(
 *   user.id,
 *   {
 *     passwordHash:
 *       newPasswordHash,
 *
 *     passwordChangedAt:
 *       new Date(),
 *
 *     passwordResetTokenHash:
 *       undefined,
 *
 *     passwordResetExpiresAt:
 *       undefined,
 *   },
 * );
 *
 */

// ============================================================
// UNIT TESTS
// ============================================================

describe(
  'PasswordResetService',
  () => {

    let service:
      PasswordResetService;

    const repository: {
      findByPasswordResetTokenHash:
        jest.Mock;

      update:
        jest.Mock;
    } = {
      findByPasswordResetTokenHash:
        jest.fn(),

      update:
        jest.fn(),
    };

    // --------------------------------------------------------
    // SETUP
    // --------------------------------------------------------

    beforeEach(
      () => {

        jest.clearAllMocks();

        service =
          new PasswordResetService(
            repository,
          );
      },
    );

    // ========================================================
    // SUCCESSFUL PASSWORD RESET
    // ========================================================

    it(
      'updates the stored password hash',
      async () => {

        const oldHash =
          await bcrypt.hash(
            'OldPassword123!',
            12,
          );

        const user: User = {
          id: 'user-1',

          email:
            'user@example.com',

          passwordHash:
            oldHash,

          emailVerified:
            true,

          passwordResetTokenHash:
            crypto
              .createHash('sha256')
              .update('reset-token')
              .digest('hex'),

          passwordResetExpiresAt:
            new Date(
              Date.now() +
              60 * 60 * 1000,
            ),

          createdAt:
            new Date(),

          updatedAt:
            new Date(),
        };

        repository
          .findByPasswordResetTokenHash
          .mockResolvedValue(
            user,
          );

        repository
          .update
          .mockResolvedValue({
            ...user,
          });

        await service.confirmPasswordReset({
          token:
            'reset-token',

          newPassword:
            'NewPassword123!',

          confirmPassword:
            'NewPassword123!',
        });

        // ----------------------------------------------------
        // UPDATE MUST OCCUR
        // ----------------------------------------------------

        expect(
          repository.update,
        ).toHaveBeenCalledTimes(1);

        // ----------------------------------------------------
        // GET UPDATE PAYLOAD
        // ----------------------------------------------------

        const [
          userId,
          changes,
        ] =
          repository.update
            .mock.calls[0];

        expect(
          userId,
        ).toBe(
          'user-1',
        );

        // ----------------------------------------------------
        // PASSWORD HASH MUST BE PRESENT
        // ----------------------------------------------------

        expect(
          changes.passwordHash,
        ).toBeDefined();

        expect(
          typeof changes.passwordHash,
        ).toBe(
          'string',
        );

        // ----------------------------------------------------
        // PASSWORD HASH MUST NOT BE PLAINTEXT
        // ----------------------------------------------------

        expect(
          changes.passwordHash,
        ).not.toBe(
          'NewPassword123!',
        );

        // ----------------------------------------------------
        // NEW HASH MUST MATCH NEW PASSWORD
        // ----------------------------------------------------

        const matches =
          await bcrypt.compare(
            'NewPassword123!',
            changes.passwordHash,
          );

        expect(
          matches,
        ).toBe(
          true,
        );

        // ----------------------------------------------------
        // OLD PASSWORD MUST NOT MATCH
        // ----------------------------------------------------

        const oldPasswordMatches =
          await bcrypt.compare(
            'OldPassword123!',
            changes.passwordHash,
          );

        expect(
          oldPasswordMatches,
        ).toBe(
          false,
        );
      },
    );

    // ========================================================
    // TOKEN INVALIDATION
    // ========================================================

    it(
      'invalidates the reset token after successful reset',
      async () => {

        repository
          .findByPasswordResetTokenHash
          .mockResolvedValue({
            id: 'user-2',

            email:
              'user@example.com',

            passwordHash:
              await bcrypt.hash(
                'OldPassword123!',
                12,
              ),

            passwordResetTokenHash:
              'stored-token',

            passwordResetExpiresAt:
              new Date(
                Date.now() +
                60 * 60 * 1000,
              ),

            emailVerified:
              true,

            createdAt:
              new Date(),

            updatedAt:
              new Date(),
          });

        repository
          .update
          .mockResolvedValue({});

        await service.confirmPasswordReset({
          token:
            'reset-token',

          newPassword:
            'NewPassword123!',

          confirmPassword:
            'NewPassword123!',
        });

        const [
          ,
          changes,
        ] =
          repository.update
            .mock.calls[0];

        expect(
          changes.passwordResetTokenHash,
        ).toBeUndefined();

        expect(
          changes.passwordResetExpiresAt,
        ).toBeUndefined();
      },
    );

    // ========================================================
    // PASSWORD CHANGED TIMESTAMP
    // ========================================================

    it(
      'updates passwordChangedAt',
      async () => {

        repository
          .findByPasswordResetTokenHash
          .mockResolvedValue({
            id: 'user-3',

            email:
              'user@example.com',

            passwordHash:
              await bcrypt.hash(
                'OldPassword123!',
                12,
              ),

            passwordResetTokenHash:
              'token',

            passwordResetExpiresAt:
              new Date(
                Date.now() +
                60 * 60 * 1000,
              ),

            emailVerified:
              true,

            createdAt:
              new Date(),

            updatedAt:
              new Date(),
          });

        repository
          .update
          .mockResolvedValue({});

        await service.confirmPasswordReset({
          token:
            'reset-token',

          newPassword:
            'NewPassword123!',

          confirmPassword:
            'NewPassword123!',
        });

        const [
          ,
          changes,
        ] =
          repository.update
            .mock.calls[0];

        expect(
          changes.passwordChangedAt,
        ).toBeInstanceOf(
          Date,
        );
      },
    );

    // ========================================================
    // INVALID TOKEN
    // ========================================================

    it(
      'rejects an invalid token',
      async () => {

        repository
          .findByPasswordResetTokenHash
          .mockResolvedValue(
            null,
          );

        await expect(
          service.confirmPasswordReset({
            token:
              'invalid-token',

            newPassword:
              'NewPassword123!',

            confirmPassword:
              'NewPassword123!',
          }),
        ).rejects.toThrow(
          'Invalid or expired password reset token',
        );

        expect(
          repository.update,
        ).not.toHaveBeenCalled();
      },
    );

    // ========================================================
    // EXPIRED TOKEN
    // ========================================================

    it(
      'rejects an expired token',
      async () => {

        repository
          .findByPasswordResetTokenHash
          .mockResolvedValue({
            id: 'user-4',

            email:
              'user@example.com',

            passwordHash:
              await bcrypt.hash(
                'OldPassword123!',
                12,
              ),

            passwordResetTokenHash:
              'token',

            passwordResetExpiresAt:
              new Date(
                Date.now() -
                60 * 1000,
              ),

            emailVerified:
              true,

            createdAt:
              new Date(),

            updatedAt:
              new Date(),
          });

        await expect(
          service.confirmPasswordReset({
            token:
              'reset-token',

            newPassword:
              'NewPassword123!',

            confirmPassword:
              'NewPassword123!',
          }),
        ).rejects.toThrow(
          'Invalid or expired password reset token',
        );
      },
    );

    // ========================================================
    // PASSWORD MISMATCH
    // ========================================================

    it(
      'rejects mismatched passwords',
      async () => {

        await expect(
          service.confirmPasswordReset({
            token:
              'reset-token',

            newPassword:
              'NewPassword123!',

            confirmPassword:
              'DifferentPassword123!',
          }),
        ).rejects.toThrow(
          'Passwords do not match',
        );

        expect(
          repository
            .findByPasswordResetTokenHash,
        ).not.toHaveBeenCalled();

        expect(
          repository.update,
        ).not.toHaveBeenCalled();
      },
    );

    // ========================================================
    // SAME PASSWORD
    // ========================================================

    it(
      'rejects using the current password again',
      async () => {

        const password =
          'CurrentPassword123!';

        repository
          .findByPasswordResetTokenHash
          .mockResolvedValue({
            id: 'user-5',

            email:
              'user@example.com',

            passwordHash:
              await bcrypt.hash(
                password,
                12,
              ),

            passwordResetTokenHash:
              'token',

            passwordResetExpiresAt:
              new Date(
                Date.now() +
                60 * 60 * 1000,
              ),

            emailVerified:
              true,

            createdAt:
              new Date(),

            updatedAt:
              new Date(),
          });

        await expect(
          service.confirmPasswordReset({
            token:
              'reset-token',

            newPassword:
              password,

            confirmPassword:
              password,
          }),
        ).rejects.toThrow(
          'New password must be different from the current password',
        );

        expect(
          repository.update,
        ).not.toHaveBeenCalled();
      },
    );

    // ========================================================
    // WEAK PASSWORD
    // ========================================================

    it(
      'rejects a password shorter than 12 characters',
      async () => {

        await expect(
          service.confirmPasswordReset({
            token:
              'reset-token',

            newPassword:
              'Short1!',

            confirmPassword:
              'Short1!',
          }),
        ).rejects.toThrow();

        expect(
          repository.update,
        ).not.toHaveBeenCalled();
      },
    );

    // ========================================================
    // DATABASE FAILURE
    // ========================================================

    it(
      'propagates password persistence failures',
      async () => {

        repository
          .findByPasswordResetTokenHash
          .mockResolvedValue({
            id: 'user-6',

            email:
              'user@example.com',

            passwordHash:
              await bcrypt.hash(
                'OldPassword123!',
                12,
              ),

            passwordResetTokenHash:
              'token',

            passwordResetExpiresAt:
              new Date(
                Date.now() +
                60 * 60 * 1000,
              ),

            emailVerified:
              true,

            createdAt:
              new Date(),

            updatedAt:
              new Date(),
          });

        repository
          .update
          .mockRejectedValue(
            new Error(
              'Database unavailable',
            ),
          );

        await expect(
          service.confirmPasswordReset({
            token:
              'reset-token',

            newPassword:
              'NewPassword123!',

            confirmPassword:
              'NewPassword123!',
          }),
        ).rejects.toThrow(
          'Database unavailable',
        );
      },
    );
  },
);

