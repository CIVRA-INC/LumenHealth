{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig*.json", "package-lock.json"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build",
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!coverage/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!coverage/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
